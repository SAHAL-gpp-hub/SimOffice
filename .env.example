# M0.0 Local Development Environment Variables

# Nginx Configuration
NGINX_HTTP_PORT=80

# Postgres Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=simoffice

# Note: App server and Sandbox Orchestrator internal ports (3000, 8080) are not
# exposed to the host network per SAD 5.0. All traffic routes through nginx on NGINX_HTTP_PORT.
